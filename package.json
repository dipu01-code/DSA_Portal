{
  "name": "dsa-portal",
  "private": true,
  "version": "0.0.1",
  "description": "DSA Practice Platform monorepo (CLI, Web, Desktop, Mobile)",
  "engines": {
    "node": "20.x"
  },
  "workspaces": [
    "core",
    "cli",
    "server",
    "workers",
    "web",
    "desktop",
    "mobile",
    "ui-core",
    "docs",
    "infra",
    "scripts"
  ],
  "scripts": {
    "install:all": "npm install",
    "dev:server": "npm run dev -w server",
    "test:core": "npm run test -w core",
    "lint": "eslint . --ext .ts,.js --ignore-path .gitignore",
    "lint:fix": "eslint . --ext .ts,.js --ignore-path .gitignore --fix",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "jest",
    "build": "npm run build -w core -w server -w workers",
    "db:up": "docker compose -f infra/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:migrate": "npm run db:migrate -w server",
    "db:migrate:down": "npm run db:migrate:down -w server",
    "db:seed": "npm run db:seed -w server",
    "db:seed-load": "tsx scripts/seed-load.ts",
    "db:reset": "npm run db:reset -w server",
    "db:import-legacy": "npm run db:import-legacy -w server",
    "db:backup": "tsx scripts/backup-db.ts",
    "db:restore": "tsx scripts/restore-db.ts"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.0",
    "socket.io-client": "^4.8.4",
    "ts-jest": "^29.4.15",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
