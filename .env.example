# Database (PostgreSQL)
POSTGRES_DB=dsa_portal
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dsa_portal

# Redis & Queue
REDIS_PASSWORD=redispassword
REDIS_URL=redis://localhost:6379

# Server Application
PORT=3000
NODE_ENV=development
JWT_SECRET=super_secret_jwt_key_development_only_change_in_prod
CORS_ORIGIN=http://localhost:5173

# Nginx & Reverse Proxy
PORT_HTTP=80
PORT_HTTPS=443

# Backup & Disaster Recovery
BACKUP_DIR=/var/backups/dsa_portal
BACKUP_RETENTION_DAYS=7
