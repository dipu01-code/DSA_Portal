# Database (PostgreSQL)
POSTGRES_DB=dsa_portal
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dsa_portal
# Pool tuning (server/src/db/pool.ts)
DB_POOL_MAX=20
DB_POOL_MIN=4
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=5000

# Redis (Person 3's cache)
REDIS_PASSWORD=redispassword
REDIS_URL=redis://localhost:6379

# Server Application
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
JWT_SECRET=super_secret_jwt_key_development_only_change_in_prod
# Auth (Person 3): bcrypt work factor for password hashes (tests use 4)
BCRYPT_COST=12

# Security (Day 8, see docs/threat-model.md)
# Browser origins allowed by CORS and Socket.IO, comma-separated. Empty: any origin in development, none in production.
CORS_ORIGINS=http://localhost:5173
# Requests per minute per client IP, and per signed-in user (429 RATE_LIMITED)
RATE_LIMIT_IP_PER_MIN=300
RATE_LIMIT_USER_PER_MIN=120
# Submissions per user (429 QUOTA_EXCEEDED); counted in PostgreSQL, so shared by all API instances
SUBMIT_QUOTA_PER_MINUTE=10
SUBMIT_QUOTA_PER_DAY=500
# Set to true only behind your own reverse proxy, so the client IP comes from X-Forwarded-For
TRUST_PROXY=false

# Worker (Day 5): parallel judging loops per process (empty = one per CPU core, Day 9), and poll fallback if a NOTIFY is missed
WORKER_CONCURRENCY=
WORKER_POLL_MS=2000
# Worker reliability (Day 6, see docs/queue-design.md)
WORKER_MAX_ATTEMPTS=3
WORKER_BACKOFF_MS=1000
WORKER_LEASE_MS=30000
# Prometheus scrape port for GET /metrics; leave empty to disable
WORKER_METRICS_PORT=9464
# API backpressure: 429 + Retry-After once this many submissions are waiting
QUEUE_MAX_WAITING=500
QUEUE_RETRY_AFTER_S=10

# Only for the end-to-end tests (npx jest); must be a separate, migrated database
TEST_DATABASE_URL=postgresql://postgres@localhost:5432/dsa_portal_test

# Nginx & Reverse Proxy
PORT_HTTP=80
PORT_HTTPS=443

# Backup & Disaster Recovery
BACKUP_DIR=/var/backups/dsa_portal
BACKUP_RETENTION_DAYS=7
