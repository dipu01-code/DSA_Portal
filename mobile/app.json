{
  "expo": {
    "name": "DSA Practice",
    "slug": "dsa-practice",
    "scheme": "dsapractice",
    "version": "0.0.1",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios", "android"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.dsaportal.mobile"
    },
    "android": {
      "package": "dev.dsaportal.mobile",
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": ["expo-router", "expo-secure-store", "./plugins/with-cleartext"],
    "experiments": {
      "typedRoutes": false
    }
  }
}
